<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_black">

    <!-- Main page content: WebView or start page -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top-right quick tools row (search-in-page, ozet, adblock stub) -->
    <LinearLayout
        android:id="@+id/topToolsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/pure_black"
        android:visibility="gone">

        <Button
            android:id="@+id/btnFindInPage"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bul"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSummarize"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Özetle"
            android:textColor="@color/orange" />

        <Button
            android:id="@+id/btnAdblock"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adblock"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Floating "Add to favorites" chip, shows for 10s after page load -->
    <Button
        android:id="@+id/btnAddFavorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:text="+ Favorilere ekle"
        android:backgroundTint="@color/orange"
        android:textColor="@color/white"
        android:visibility="gone" />

    <!-- Bottom bar: back, forward, url/search field, tabs, private toggle -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_bottom_bar">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/white" />

        <EditText
            android:id="@+id/urlField"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_search_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="Bing'de ara veya adres yaz"
            android:textColorHint="@color/gray_text"
            android:textColor="@color/white"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/btnTabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_tabs" />

        <ImageButton
            android:id="@+id/btnPrivate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_private" />

    </LinearLayout>

    <!-- Tab switcher panel, slides up from bottom bar -->
    <LinearLayout
        android:id="@+id/tabsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="84dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_bar"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:padding="8dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="360dp">

            <LinearLayout
                android:id="@+id/tabsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnNewTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Yeni sekme"
            android:textColor="@color/orange"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
